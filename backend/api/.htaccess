# The API: every request under /api/ goes to index.php, the front controller.
# No other file here is meant to be asked for - the route and helper files,
# called on their own, would only fail. The first rule stops the rewrite
# looping on index.php itself.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^index\.php$ - [L]
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "\.(php|phtml|phar)$">
    Require all denied
</FilesMatch>
<FilesMatch "^index\.php$">
    Require all granted
</FilesMatch>
